option (ENABLE_CLBLAST "Use CLBlast (OpenCL BLAS) on the GPU for QBridge's streamed Gram matrices and projections" ON)

if (ENABLE_CLBLAST)
    if (NOT ENABLE_OPENCL)
        set (ENABLE_CLBLAST OFF)
        message (WARNING "ENABLE_CLBLAST requires ENABLE_OPENCL; CLBlast is OFF.")
    else (NOT ENABLE_OPENCL)
        find_package (CLBlast CONFIG)
        if (CLBlast_FOUND)
            target_link_libraries (qrack PUBLIC clblast)
            target_compile_definitions (qrack PUBLIC QRACK_ENABLE_CLBLAST=1)
            message ("CLBlast (for QBridge) is: ON")
        else (CLBlast_FOUND)
            set (ENABLE_CLBLAST OFF)
            message (WARNING "ENABLE_CLBLAST requested, but CLBlast was not found (set CLBlast_DIR); CLBlast is OFF.")
        endif (CLBlast_FOUND)
    endif (NOT ENABLE_OPENCL)
else (ENABLE_CLBLAST)
    message ("CLBlast (for QBridge) is: OFF")
endif (ENABLE_CLBLAST)
